{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug xpodcasts (native)",
      "type": "lldb",
      "request": "launch",
      "cargo": {
        "args": [
          "build",
          "--bin=xpodcasts"
        ]
      },
      "args": [],
      "cwd": "${workspaceFolder}",
      "env": {
        "RUST_LOG": "xpodcasts=debug,podcasts_data=debug,glib=debug",
        "RUST_BACKTRACE": "1",
        "LC_ALL": "ko_KR.UTF-8"
      },
      "initCommands": [
        "process handle SIGCHLD --stop false --pass true --notify false",
        "process handle SIGWINCH --stop false --pass true --notify false"
      ]
    }
  ]
}